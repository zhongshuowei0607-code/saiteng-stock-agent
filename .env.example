# 数据源（可留空，系统会尝试 AKShare）
TUSHARE_TOKEN=

# LLM（可完全关闭）
LLM_PROVIDER=disabled
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# 本机 Ollama：http://localhost:11434
OLLAMA_URL=

# Bark
BARK_ENABLED=false
BARK_BASE_URL=https://api.day.app
BARK_DEVICE_KEY=

# Email（QQ 邮箱密码填写授权码）
EMAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Web（默认仅本机；手机打开日报时才需要局域网地址）
WEB_HOST=127.0.0.1
WEB_AUTH_REQUIRED=false
ALLOWED_HOSTS=127.0.0.1,localhost
# 手机能访问的地址，例如 http://192.168.0.103:8000；留空则 Bark 不加链接
REPORT_PUBLIC_URL=
