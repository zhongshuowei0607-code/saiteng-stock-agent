# 数据源（可留空，系统会尝试 AKShare）
TUSHARE_TOKEN=

# LLM（可完全关闭；DS220+ 不要运行本地大型模型）
LLM_PROVIDER=disabled
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# 远程 Ollama 示例：http://192.168.1.10:11434
OLLAMA_URL=

# Bark
BARK_ENABLED=false
BARK_BASE_URL=https://api.day.app
BARK_DEVICE_KEY=

# Email（QQ 邮箱密码填写授权码）
EMAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Web 与安全
WEB_PORT=18000
DASHBOARD_PUBLIC_URL=
WEB_AUTH_REQUIRED=true
API_SECRET=
